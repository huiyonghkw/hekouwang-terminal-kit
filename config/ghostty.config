# ============================================================
# hekouwang-terminal-kit · Ghostty config
# 会勇禾口王 · Ghostty 配置
# ⚠️ 上面那行 ASCII 标记是 install.sh / uninstall.sh 认「这份 config 是自家写的」
#    的唯一依据（以前认的是中文标题，双语之后那行会变，一变就永远认不出来）。别删。
# 与 iTerm2 同源：配色由 hekouwang-iterm2-skill/config/themes/_generate.py 生成，
# 装在 ~/.config/ghostty/themes/hekouwang-*（别手改那些文件，改 PALETTES 再重跑生成器）。
#
# 换肤：跑 ~/.claude/skills/hekouwang-iterm2-skill/theme.sh <主题名>，
#       它同时切 iTerm2 和 Ghostty（下面这行 theme 由脚本改写，别手动动）。
#       改完按 Cmd+Shift+, 重载 —— Ghostty 没有 iTerm2 那种保存即生效。
#
# ⚠️ 语法：注释只能独占一行。写在值后面会被当成值的一部分（background = #123abc 那种坑）。
# ============================================================

# 配色主题属付费包（config/themes/ghostty/）。开源版不带，
# 这里留空即用 Ghostty 自带配色；下面的字体/质感/回滚设置照常生效。
# theme =


# ---- 字体（对应 iTerm2 的 MapleMono-NF-CN-Regular 15）----
# Maple Mono NF CN：SIL OFL-1.1，免费可商用可分发，自带 Nerd Font 图标 + 中文等宽。
# ⚠️ Ghostty 这里写的是 family 名（Maple Mono NF CN），iTerm2 那边写的是
#    PostScript 名（MapleMono-NF-CN-Regular）—— 两个 App 的取名口径不一样，别互相抄。
# 第二条 font-family = 缺字回退，等价 iTerm2 的 Non-ASCII Font。
font-family = Maple Mono NF CN
font-family = Symbols Nerd Font Mono
font-size = 15

# iTerm2 的 Vertical Spacing 1.05 = 行高多给 5%
adjust-cell-height = 5%


# ---- 质感层（对应 iTerm2 的 Transparency 0.08 + Blur Radius 20）----
# 0.92 不透明度 = 一点空气感，桌面被 blur 糊成色块认不出内容；
# 录屏要绝对干净就临时改 1.0。低于 0.85 开始影响可读性，别调。
background-opacity = 0.92
background-blur-radius = 20


# ---- 光标 ----
# 竖条 + 不闪：闪烁光标在剪辑抽帧里会忽明忽暗
cursor-style = bar
cursor-style-blink = false


# ---- 窗口与回滚 ----
window-width = 160
window-height = 40
# Ghostty 的回滚按字节算（默认 10MB），给到 100MB 约等于 iTerm2 的 Unlimited Scrollback
scrollback-limit = 100000000


# ---- SSH 集成 ----
# 治 SSH 上服务器后 clear/vim/tmux 报 'xterm-ghostty': unknown terminal type。
# 根因：Ghostty 用自家 terminfo，服务器的 terminfo 库里没这条记录。
# ssh-terminfo 首次登录时把 xterm-ghostty 装进远端 ~/.terminfo/（不用 root，一台装一次，之后免费）；
# ssh-env 把 TERM 等环境变量带过去。
# ⚠️ 这一行是全量列表不是增量：其余四项照抄出厂默认（no- 前缀＝关闭），
#    删掉其中任何一项 = 把那项默认也关了。出厂默认见 ghostty +show-config --default。
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path


# ---- 同步不过来的 ----
# iTerm2 的 Triggers（ERROR/WARN/SUCCESS 高亮、密码提示自动弹密码管理器）和底部状态栏，
# Ghostty 都没有对应机制，只能留在 iTerm2 那边。
