# ~/.zshrc.local — 私有配置模板（复制为 ~/.zshrc.local 后填入真实值）
# ⚠️ 此文件包含服务器 IP / 代理等敏感信息，永远不要提交到 git
# 英文版（默认）：config/zshrc.local.example

# ---- SSH 服务器别名（命名约定：环境-用途 或 ecs:项目:IP尾号）----
# alias mycompany-dev="ssh -o ServerAliveInterval=60 root@<DEV_IP>"
# alias mycompany-prod="ssh -o ServerAliveInterval=60 root@<PROD_IP>"
# alias ecs:project:NN="ssh -o ServerAliveInterval=60 -p <PORT> root@<IP>"
#
# 💡 更推荐写进 ~/.ssh/config（scp/rsync/VS Code Remote 都能用）：
#   Host mycompany-dev
#       HostName <DEV_IP>
#       User root
#       ServerAliveInterval 60

# ---- 代理开关（不要写死 export，代理没开时网络命令会卡死）----
proxy_on() {
  export https_proxy=http://127.0.0.1:10080
  export http_proxy=http://127.0.0.1:10080
  export all_proxy=socks5://127.0.0.1:10081
  echo "proxy on"
}
proxy_off() {
  unset https_proxy http_proxy all_proxy
  echo "proxy off"
}

# ---- 其他公司/个人专属环境变量 ----
# export XXX_TOKEN=...
